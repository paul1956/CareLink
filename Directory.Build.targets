<Project>
  <!--
    Remove duplicate WebView2 native DLL from project outputs at packaging time
    for any project in the repository. This avoids APPX/PACK duplicate payload errors
    when a project's output contains a local copy of the native DLL and the NuGet
    package also contributes the same file.
  -->
  <Target Name="RemoveDuplicateWebView2_Global" BeforeTargets="BeforeBuild;Pack;Publish;CreateAppxPackage">
    <!-- Find any package-provided Microsoft.Web.WebView2.Core.dll in the NuGet package cache (any version) -->
    <ItemGroup>
      <_WebView2PackageDlls Include="$(NuGetPackageRoot)microsoft.web.webview2\**\runtimes\win-x64\native_uap\Microsoft.Web.WebView2.Core.dll" />
    </ItemGroup>

    <!-- Only proceed when a package-provided DLL was found -->
    <PropertyGroup>
      <_HasWebView2PackageFiles>$([System.String]::Copy('%(_WebView2PackageDlls.Identity)'))</_HasWebView2PackageFiles>
      <_WebView2Dll>$(OutputPath)Microsoft.Web.WebView2.Core.dll</_WebView2Dll>
    </PropertyGroup>

    <Message Importance="High" Text="Found WebView2 package copy: %(_WebView2PackageDlls.Identity)" Condition="'@(_WebView2PackageDlls)' != ''" />
    <Message Importance="High" Text="Removing duplicate WebView2 DLL from output if present: $(_WebView2Dll)" Condition="'@(_WebView2PackageDlls)' != '' And '$(PreserveWebView2Output)' != 'true'" />
    <Delete Files="$(_WebView2Dll)" Condition="'@(_WebView2PackageDlls)' != '' And Exists('$(_WebView2Dll)') And '$(PreserveWebView2Output)' != 'true'" />

    <!-- Also remove any copies in other project outputs under the repository (e.g., referenced project outputs)
         This ensures packaging of test projects or other projects that gather outputs does not include
         both the NuGet package copy and a project output copy from a different project. -->
    <ItemGroup>
      <_LocalWebView2Outputs Include="$(MSBuildThisFileDirectory)**\bin\**\Microsoft.Web.WebView2.Core.dll" />
    </ItemGroup>

    <Message Importance="High" Text="Found local WebView2 copies: %(_LocalWebView2Outputs.Identity)" Condition="'@(_LocalWebView2Outputs)' != '' And '@(_WebView2PackageDlls)' != '' And '$(PreserveWebView2Output)' != 'true'" />
    <Delete Files="@(_LocalWebView2Outputs)" Condition="'@(_LocalWebView2Outputs)' != '' And '@(_WebView2PackageDlls)' != '' And '$(PreserveWebView2Output)' != 'true'" />
  </Target>
</Project>
